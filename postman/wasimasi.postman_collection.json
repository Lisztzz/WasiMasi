        {
          "name": "Busqueda avanzada (US09/US10)",
          "item": [
            {
              "name": "Buscar con condiciones (US09)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status 200', () => pm.response.to.have.status(200));",
                      "pm.test('respeta las condiciones', () => {",
                      "  pm.response.json().forEach(p => {",
                      "    pm.expect(p.mascotasPermitidas).to.eql(true);",
                      "    pm.expect(['F', 'Any']).to.include(p.generoPreferido);",
                      "    pm.expect(p.servicios.toLowerCase()).to.include('wifi');",
                      "  });",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/publicaciones?zona=Jesus Maria&precioMin=300&precioMax=800&mascotas=true&genero=F&servicios=wifi",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "publicaciones"
                  ],
                  "query": [
                    {
                      "key": "zona",
                      "value": "Jesus Maria"
