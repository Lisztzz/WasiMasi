/* Configuración de TypeScript para los tests unitarios (Vitest + Angular TestBed). */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals"],
    "outDir": "./out-tsc/spec"
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    "src/**/*.ts"
  ],
  "exclude": []
}
